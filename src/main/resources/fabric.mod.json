{
  "schemaVersion": 1,
  "id": "village-castles",
  "version": "${version}",
  "name": "Village Castles",
  "description": "Adds grand, biome-themed castle structures to villages",
  "authors": [
    "justfatlard"
  ],
  "contact": {
    "homepage": "https://github.com/fatlard1993/village-castles",
    "sources": "https://github.com/fatlard1993/village-castles"
  },
  "license": "MIT",
  "icon": "assets/village-castles/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.villagecastles.VillageCastles"
    ]
  },
  "mixins": [
    "village-castles.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "minecraft": "${minecraftDependency}",
    "java": ">=25",
    "fabric-api": "${fabricApiVersion}"
  },
  "suggests": {
    "village-builder": "*",
    "village-quests-justfatlard": "*"
  }
}
