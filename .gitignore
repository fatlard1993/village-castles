# Gradle
.gradle/
# Anchored: an unanchored "build/" also matches a build directory at any depth, which silently
# swallowed src/main/java/com/villagecastles/generator/build/ and everything in it.
/build/

# IDE
.idea/
*.iml
.vscode/

# Minecraft runtime
run/

# Java artifacts
*.hprof
*.class

# Fabric Loom
remappedSrc/

# OS
.DS_Store
Thumbs.db

# Generated resources (regenerate with gradle)
src/main/generated/

.claude/
